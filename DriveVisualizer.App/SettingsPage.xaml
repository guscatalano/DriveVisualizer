<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DriveVisualizer_App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="CardDescStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel MaxWidth="760" Padding="24,12,24,32" Spacing="8" HorizontalAlignment="Center">

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,12">
                <Button Click="Back_Click" Padding="8,6" ToolTipService.ToolTip="Back">
                    <FontIcon x:Name="BackIcon" FontSize="14" />
                </Button>
                <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Auto-save scans" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource CardDescStyle}"
                                   Text="Keeps one snapshot per day per target. Powers the Change column, 'What changed since last scan', and Size history." />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoSaveToggle" Grid.Column="1" MinWidth="0" Margin="0,-4,-12,-8"
                                  Toggled="AutoSaveToggle_Toggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Theme" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource CardDescStyle}"
                                   Text="The visualization canvas stays dark in both themes — its colors are tuned for it." />
                    </StackPanel>
                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" MinWidth="190" VerticalAlignment="Center"
                              SelectionChanged="Theme_Changed">
                        <ComboBoxItem Content="Use system setting" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Size detail" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource CardDescStyle}"
                                   Text="How precisely sizes are shown across the app. Hovering a size always shows every unit." />
                    </StackPanel>
                    <ComboBox x:Name="SizeDetailCombo" Grid.Column="1" MinWidth="190" VerticalAlignment="Center"
                              SelectionChanged="SizeDetail_Changed">
                        <ComboBoxItem Content="Compact (251.3 GB)" />
                        <ComboBoxItem Content="Detailed (251.327 GB)" />
                        <ComboBoxItem Content="Exact bytes" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Automatic snapshots" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Style="{StaticResource CardDescStyle}"
                                       Text="While the app is open, re-scan the current target and snapshot it at this cadence. 'Off' records snapshots only when you scan manually." />
                        </StackPanel>
                        <ComboBox x:Name="FrequencyCombo" Grid.Column="1" MinWidth="190" VerticalAlignment="Center"
                                  SelectionChanged="Frequency_Changed">
                            <ComboBoxItem Content="Off — manual scans only" />
                            <ComboBoxItem Content="Hourly" />
                            <ComboBoxItem Content="Daily" />
                            <ComboBoxItem Content="Weekly" />
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Keep snapshots" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Style="{StaticResource CardDescStyle}"
                                       Text="Older snapshots are pruned after each scan; the newest is always kept as the diff baseline." />
                        </StackPanel>
                        <ComboBox x:Name="RetentionCombo" Grid.Column="1" MinWidth="190" VerticalAlignment="Center"
                                  SelectionChanged="Retention_Changed">
                            <ComboBoxItem Content="Unlimited" />
                            <ComboBoxItem Content="Last 10" />
                            <ComboBoxItem Content="Last 50" />
                            <ComboBoxItem Content="Last 30 days" />
                            <ComboBoxItem Content="Last 90 days" />
                            <ComboBoxItem Content="Last year" />
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Snapshot data" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Style="{StaticResource CardDescStyle}"
                                       Text="One folder holds the last-scan baseline and the size history." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Open folder" Click="OpenHistory_Click" />
                            <Button Content="Clear…" Click="ClearHistory_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Snapshot even when the app is closed" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:Name="ScheduledTaskDesc" Style="{StaticResource CardDescStyle}"
                                       Text="Registers a Windows scheduled task that runs a hidden scan of the current target at the cadence above. Cadence changes update the task automatically; re-enable to change the target." />
                        </StackPanel>
                        <ToggleSwitch x:Name="ScheduledTaskToggle" Grid.Column="1" MinWidth="0" Margin="0,-4,-12,-8"
                                      Toggled="ScheduledTask_Toggled" />
                    </Grid>
                    <TextBlock Style="{StaticResource CardDescStyle}"
                               Text="Without the scheduled task, snapshots are only taken while DriveVisualizer itself is running." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel>
                        <TextBlock Text="MCP server" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Style="{StaticResource CardDescStyle}"
                                   Text="Lets AI assistants (Claude Code, VS Code Copilot, …) scan folders, read snapshot history, diff snapshots, and check drive health. Read-only: no tool can delete or change files. Listens on localhost only, with no authentication — start it when you need it." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Port:" VerticalAlignment="Center" />
                        <NumberBox x:Name="McpPortBox" Width="100" Value="18766" Minimum="1024" Maximum="65535" ValueChanged="McpPort_Changed" />
                        <Button x:Name="McpStartButton" Click="McpStart_Click" Content="Start" />
                        <Button x:Name="McpStopButton" Click="McpStop_Click" Content="Stop" IsEnabled="False" />
                        <TextBlock x:Name="McpStatusLabel" Text="stopped" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <InfoBar x:Name="McpStatusBar" IsClosable="True" />
                    <TextBlock Text="Claude Code" Style="{StaticResource CardDescStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="CfgClaudeCodeBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" MinWidth="520" />
                        <Button Click="McpCopyConfig_Click" Tag="ClaudeCode" Content="Copy" VerticalAlignment="Top" />
                    </StackPanel>
                    <TextBlock Text="VS Code (mcp.json)" Style="{StaticResource CardDescStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="CfgVsCodeBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" MinWidth="520" />
                        <Button Click="McpCopyConfig_Click" Tag="VsCode" Content="Copy" VerticalAlignment="Top" />
                    </StackPanel>
                    <TextBlock Text="curl smoke-test" Style="{StaticResource CardDescStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox x:Name="CfgCurlBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" MinWidth="520" />
                        <Button Click="McpCopyConfig_Click" Tag="Curl" Content="Copy" VerticalAlignment="Top" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Layout &amp; view" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Style="{StaticResource CardDescStyle}"
                               Text="The map position (below / right) and the visualization style (treemap, sunburst, icicle) are set with the toolbar buttons and remembered automatically." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="AboutTitle" Text="DriveVisualizer" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Style="{StaticResource CardDescStyle}"
                               Text="See what's eating your disk: scan, map, clean up." />
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
                        <HyperlinkButton Content="github.com/guscatalano/DriveVisualizer"
                                         NavigateUri="https://github.com/guscatalano/DriveVisualizer" Padding="0" />
                        <HyperlinkButton Content="guscatalano.dev"
                                         NavigateUri="https://guscatalano.dev" Padding="0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CardDescStyle}"
                               Text="Built with WinUI 3, Win2D, and the Windows App SDK. MIT licensed." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
