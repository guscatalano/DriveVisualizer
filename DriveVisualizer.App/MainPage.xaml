<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DriveVisualizer_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:DriveVisualizer_App.Controls"
    xmlns:vm="using:DriveVisualizer_App.ViewModels"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
        <KeyboardAccelerator Key="Delete" Invoked="DeleteAccelerator_Invoked" />
        <KeyboardAccelerator Key="Delete" Modifiers="Shift" Invoked="ShiftDeleteAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <MenuFlyout x:Key="MapMenu" Opening="RowMenu_Opening">
            <MenuFlyoutItem Text="Open" Click="Menu_Open" />
            <MenuFlyoutItem Text="Show in Explorer" Click="Menu_Reveal" />
            <MenuFlyoutItem Text="Copy path" Click="Menu_CopyPath" />
            <MenuFlyoutItem Tag="refresh" Text="Refresh this folder" Click="Menu_RefreshFolder" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Tag="compress" Text="Compress and delete original" Click="Menu_Compress" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Delete (Recycle Bin)" Click="Menu_Recycle" />
            <MenuFlyoutItem Text="Delete permanently" Click="Menu_DeletePermanent" />
        </MenuFlyout>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="12,4,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.4*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="0" />
        </Grid.ColumnDefinitions>

        <!-- Toolbar -->
        <Grid x:Name="ToolbarPanel" Grid.Row="0" Grid.ColumnSpan="3" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox
                MinWidth="220"
                IsEnabled="{x:Bind ViewModel.IsNotScanning, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Targets}"
                SelectedItem="{x:Bind ViewModel.SelectedTarget, Mode=TwoWay}" />
            <Button
                Content="Browse…"
                Click="Browse_Click"
                IsEnabled="{x:Bind ViewModel.IsNotScanning, Mode=OneWay}" />
            <Button
                Style="{StaticResource AccentButtonStyle}"
                MinWidth="80"
                Content="{x:Bind ViewModel.ScanButtonText, Mode=OneWay}"
                Command="{x:Bind ViewModel.ScanOrStopCommand}" />
            <ProgressRing
                Width="20" Height="20"
                IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
            <AppBarSeparator />
            <Button x:Name="LayoutToggleButton" Click="LayoutToggle_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="LayoutToggleIcon" Glyph="" FontSize="14" />
                    <TextBlock x:Name="LayoutToggleText" Text="Map below" />
                </StackPanel>
            </Button>
            <Button Content="Columns">
                <Button.Flyout>
                    <MenuFlyout>
                        <ToggleMenuFlyoutItem Text="% of parent" IsChecked="{x:Bind ViewModel.Prefs.ShowPercent, Mode=TwoWay}" />
                        <ToggleMenuFlyoutItem Text="Size" IsChecked="{x:Bind ViewModel.Prefs.ShowSize, Mode=TwoWay}" />
                        <ToggleMenuFlyoutItem Text="Change" IsChecked="{x:Bind ViewModel.Prefs.ShowChange, Mode=TwoWay}" />
                        <ToggleMenuFlyoutItem Text="Files" IsChecked="{x:Bind ViewModel.Prefs.ShowFiles, Mode=TwoWay}" />
                        <ToggleMenuFlyoutItem Text="Modified" IsChecked="{x:Bind ViewModel.Prefs.ShowModified, Mode=TwoWay}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="FilterButton" Content="Filter" />
            <DropDownButton Content="Report">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="What changed since last scan" Click="Report_Diff" />
                        <MenuFlyoutItem Text="Size history…" Click="Report_History" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Export HTML report…" Click="Report_Export" />
                        <MenuFlyoutItem Text="Compare with a snapshot file…" Click="Report_Compare" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Save snapshot as…" Click="Report_SaveSnapshot" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <CheckBox
                x:Name="CleanupCheckBox"
                Content="Cleanup candidates"
                MinWidth="0"
                VerticalAlignment="Center"
                Checked="CleanupCheckBox_Toggled"
                Unchecked="CleanupCheckBox_Toggled"
                ToolTipService.ToolTip="Show only files that look safe to review for deletion: temp folders, caches, logs, recycle bin, node_modules" />
            <CheckBox
                x:Name="WatchCheckBox"
                Content="Watch"
                MinWidth="0"
                VerticalAlignment="Center"
                Checked="WatchCheckBox_Toggled"
                Unchecked="WatchCheckBox_Toggled"
                ToolTipService.ToolTip="Auto-refresh folders when files change on disk" />
        </StackPanel>
            <Button x:Name="SettingsButton" Grid.Column="1" Padding="9,6" VerticalAlignment="Center" HorizontalAlignment="Right">
                <FontIcon x:Name="SettingsIcon" FontSize="15" />
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Spacing="10" MinWidth="280">
                            <TextBlock Text="Settings" FontWeight="SemiBold" />
                            <ToggleSwitch
                                x:Name="AutoSaveToggle"
                                Header="Auto-save last scan (enables 'What changed since last scan')"
                                Toggled="AutoSaveToggle_Toggled" />
                            <ComboBox
                                x:Name="SizeDetailCombo"
                                Header="Size detail"
                                MinWidth="200"
                                SelectionChanged="SizeDetail_Changed">
                                <ComboBoxItem Content="Compact (251.3 GB)" />
                                <ComboBoxItem Content="Detailed (251.327 GB)" />
                                <ComboBoxItem Content="Exact bytes" />
                            </ComboBox>
                            <TextBlock
                                Text="Layout is set with the Map below / Map right toolbar button and remembered as the default."
                                TextWrapping="Wrap"
                                MaxWidth="260"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <HyperlinkButton Content="About DriveVisualizer" Click="About_Click" Padding="0" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Column headers (widths mirror the item template below) -->
        <Grid x:Name="HeaderGrid" Grid.Row="1" Grid.ColumnSpan="3" Padding="16,0,24,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Name" Style="{ThemeResource CaptionTextBlockStyle}" />
            <TextBlock Grid.Column="1" Width="140" Text="% of parent" Style="{ThemeResource CaptionTextBlockStyle}" Visibility="{x:Bind ViewModel.Prefs.ShowPercent, Mode=OneWay}" />
            <TextBlock Grid.Column="2" Width="{x:Bind ViewModel.Prefs.SizeColumnWidth, Mode=OneWay}" Text="Size" TextAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Visibility="{x:Bind ViewModel.Prefs.ShowSize, Mode=OneWay}" />
            <TextBlock Grid.Column="3" Width="{x:Bind ViewModel.Prefs.ChangeColumnWidth, Mode=OneWay}" Text="Change" TextAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Visibility="{x:Bind ViewModel.Prefs.ShowChange, Mode=OneWay}"
                       ToolTipService.ToolTip="{x:Bind ViewModel.ChangeBaselineText, Mode=OneWay}" />
            <TextBlock Grid.Column="4" Width="80" Text="Files" TextAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Visibility="{x:Bind ViewModel.Prefs.ShowFiles, Mode=OneWay}" />
            <TextBlock Grid.Column="5" Width="140" Text="Modified" TextAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Visibility="{x:Bind ViewModel.Prefs.ShowModified, Mode=OneWay}" />
        </Grid>

        <!-- Directory tree (flattened, virtualized) -->
        <ListView
            x:Name="TreeList"
            Grid.Row="2" Grid.ColumnSpan="3"
            SelectionMode="Single"
            ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
            DoubleTapped="TreeList_DoubleTapped">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="30" />
                    <Setter Property="Padding" Value="4,0,12,0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:NodeRow">
                    <Grid Background="Transparent">
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="RowMenu_Opening">
                                <MenuFlyoutItem Text="Open" Click="Menu_Open" />
                                <MenuFlyoutItem Text="Show in Explorer" Click="Menu_Reveal" />
                                <MenuFlyoutItem Text="Copy path" Click="Menu_CopyPath" />
                                <MenuFlyoutItem Tag="refresh" Text="Refresh this folder" Click="Menu_RefreshFolder" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Tag="compress" Text="Compress and delete original" Click="Menu_Compress" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Delete (Recycle Bin)" Click="Menu_Recycle" />
                                <MenuFlyoutItem Text="Delete permanently" Click="Menu_DeletePermanent" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="{x:Bind Indent}" Spacing="4">
                            <Button
                                Width="24" Height="24" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                IsHitTestVisible="{x:Bind HasChildren, Mode=OneWay}"
                                Click="Chevron_Click">
                                <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="10" />
                            </Button>
                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <FontIcon Glyph="{x:Bind Badge, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Width="140" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                    Visibility="{x:Bind Prefs.ShowPercent, Mode=OneWay}">
                            <ProgressBar Width="70" Maximum="100" Value="{x:Bind PercentOfParent, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind PercentText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" Width="{x:Bind Prefs.SizeColumnWidth, Mode=OneWay}" Text="{x:Bind SizeText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind SizeTooltip, Mode=OneWay}" TextAlignment="Right" VerticalAlignment="Center"
                                   Visibility="{x:Bind Prefs.ShowSize, Mode=OneWay}" />
                        <TextBlock Grid.Column="3" Width="{x:Bind Prefs.ChangeColumnWidth, Mode=OneWay}" Text="{x:Bind DeltaText}" ToolTipService.ToolTip="{x:Bind DeltaTooltip}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{x:Bind DeltaBrush}"
                                   Visibility="{x:Bind Prefs.ShowChange, Mode=OneWay}" />
                        <TextBlock Grid.Column="4" Width="80" Text="{x:Bind FilesText, Mode=OneWay}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind Prefs.ShowFiles, Mode=OneWay}" />
                        <TextBlock Grid.Column="5" Width="140" Text="{x:Bind ModifiedText}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind Prefs.ShowModified, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Splitter -->
        <Grid
            x:Name="SplitterBar"
            Grid.Row="3" Grid.ColumnSpan="3"
            Height="12"
            Background="Transparent"
            ManipulationMode="TranslateY"
            ManipulationDelta="Splitter_ManipulationDelta">
            <Border
                x:Name="SplitterGrip"
                Width="48" Height="4"
                CornerRadius="2"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource ControlStrongFillColorDefaultBrush}" />
        </Grid>

        <!-- Treemap host: legend + canvas -->
        <Grid x:Name="TreemapHost" Grid.Row="4" Grid.ColumnSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ItemsControl
                Grid.Row="0"
                Margin="2,0,2,6"
                ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:WrapPanel HorizontalSpacing="14" VerticalSpacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryStat">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Opacity="{x:Bind Opacity}">
                            <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="{x:Bind Swatch}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Name}" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind SizeText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="1" CornerRadius="6">
                <win2d:CanvasControl
                    x:Name="TreemapCanvas"
                    Draw="TreemapCanvas_Draw"
                    PointerMoved="TreemapCanvas_PointerMoved"
                    PointerExited="TreemapCanvas_PointerExited"
                    PointerPressed="TreemapCanvas_PointerPressed"
                    DoubleTapped="TreemapCanvas_DoubleTapped"
                    SizeChanged="TreemapCanvas_SizeChanged" />
                <StackPanel
                    x:Name="ZoomBar"
                    Orientation="Horizontal" Spacing="8"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="8,8,0,0">
                    <Button
                        x:Name="ZoomOutButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="ZoomOut_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="ZoomOutIcon" FontSize="13" />
                            <TextBlock Text="Zoom out" />
                        </StackPanel>
                    </Button>
                    <Border
                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock x:Name="ZoomPathText" Style="{ThemeResource CaptionTextBlockStyle}" />
                    </Border>
                </StackPanel>
                <Border
                    x:Name="HoverTip"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,4">
                    <TextBlock x:Name="HoverTipText" Style="{ThemeResource CaptionTextBlockStyle}" />
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid x:Name="StatusBar" Grid.Row="5" Grid.ColumnSpan="3" Padding="4,6,4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Page>
